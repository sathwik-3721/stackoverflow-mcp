# Optional: Stack Exchange API key (increases daily quota from ~300 to 10,000 requests/day)
# Free registration at https://stackapps.com/
STACKEXCHANGE_KEY=

# Hard ceiling on results per query, regardless of what a tool call requests (default: 10, per spec max: 10)
STACKOVERFLOW_MAX_RESULTS=10

# Network request timeout in seconds (default: 15)
STACKOVERFLOW_API_TIMEOUT_SECONDS=15

# Maximum retry attempts for transient API failures (default: 3)
STACKOVERFLOW_API_MAX_RETRIES=3

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
STACKOVERFLOW_LOG_LEVEL=INFO
